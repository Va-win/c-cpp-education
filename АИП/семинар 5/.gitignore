# ==========================================
# 1. Каталоги сборки CMake
# ==========================================
build/
build-*/
cmake-build-*/
out/
bin/

# ==========================================
# 2. Исполняемые и бинарные файлы
# ==========================================
# Windows
*.exe
*.dll

# Linux / macOS (бинарники без расширений и библиотеки)
*.out
*.so
*.dylib
*.a

# Объектные файлы компилятора
*.o
*.obj

# ==========================================
# 3. Служебные файлы отладки и кэша
# ==========================================
*.pdb
*.ilk
*.dSYM/
*.gch
*.pch

# ==========================================
# 4. Настройки редакторов и IDE
# ==========================================
# VS Code (локальные пути, кроме рекомендованных расширений)
.vscode/*
!.vscode/extensions.json

# JetBrains (CLion)
.idea/

# Visual Studio
.vs/

# ==========================================
# 5. Системный мусор ОС
# ==========================================
.DS_Store
Thumbs.db
Desktop.ini